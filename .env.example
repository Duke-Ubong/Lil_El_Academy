# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Email / SMTP Configuration for Parent Inquiry Submissions
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="notifications@lilelacademy.com"
SMTP_PASS="your-secure-smtp-app-password"
SMTP_SECURE="false"
CONTACT_EMAIL_TO="admissions@lilelacademy.com"
CONTACT_EMAIL_FROM="Lil-El Academy Admissions <admissions@lilelacademy.com>"

